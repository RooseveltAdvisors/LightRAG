# LightRAG MCP Server Dockerfile
# Lean Python image with just MCP SDK and LightRAG client library

FROM python:3.11-slim

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /app

# Copy MCP server script
COPY lightrag_mcp.py /app/

# Install dependencies using uv (stdio version - simpler, no web server needed)
RUN uv pip install --system \
    lightrag-hku \
    mcp

# Keep container running for docker exec connections
CMD ["tail", "-f", "/dev/null"]
